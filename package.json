{
  "name": "meshbreakers",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A 3D tactical dice roguelike for phones and iOS.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "ios:add": "cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "three": "0.185.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "@types/three": "^0.183.1",
    "@capacitor/cli": "^8.0.0"
  }
}
